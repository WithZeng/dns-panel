SECRET_KEY=replace_with_a_random_64_hex_string
TZ=Asia/Shanghai
PANEL_PORT=5000
PUBLIC_PANEL_URL=
DNS_FAILOVER_TEST_MODE=panel_local
DNS_PANEL_DISABLE_SCHEDULER=0

# Google Drive backup (optional)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# GitHub account sync (optional)
GITHUB_SYNC_REPO=

# Data retention in days
DATA_RETENTION_DAYS=90

# Initial admin password (only used during first DB init; random if unset)
ADMIN_PASSWORD=
