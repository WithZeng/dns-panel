# DNS Panel Go - Configuration
# Copy to .env and edit as needed

# Server
PANEL_PORT=5000
PANEL_DEBUG=false

# Security (auto-generated if not set)
# SECRET_KEY=
# ENCRYPT_KEY=

# Database
# DNS_PANEL_DB_PATH=data/panel.db

# Data retention in days
DATA_RETENTION_DAYS=90

# Timezone
TZ=Asia/Shanghai

# Public URL (for generated scripts)
# PUBLIC_PANEL_URL=https://panel.example.com

# Google Drive backup (optional)
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# GitHub account sync (optional)
# GITHUB_SYNC_REPO=

# Initial admin password (random if unset, only used on first DB init)
# ADMIN_PASSWORD=
